{
  "name": "手机与电脑生产计划优化",
  "assumptions": [
    "生产数量可按连续单位计量，因为未要求整数产量",
    "手机和电脑的单位利润固定不变",
    "芯片、屏幕和组装工时是唯一资源限制，供应量每天固定",
    "生产出的产品全部销售，不考虑库存或需求上限（除电脑不超过手机的市场策略）",
    "电脑不能超过手机的产量约束按数量单位比较"
  ],
  "variables": [
    {
      "name": "x_phone",
      "description": "每天生产的手机数量",
      "unit": "部",
      "kind": "continuous",
      "lower": 0,
      "upper": null
    },
    {
      "name": "x_computer",
      "description": "每天生产的电脑数量",
      "unit": "台",
      "kind": "continuous",
      "lower": 0,
      "upper": null
    }
  ],
  "objective": {
    "sense": "max",
    "terms": [
      {
        "variable": "x_phone",
        "coefficient": 500
      },
      {
        "variable": "x_computer",
        "coefficient": 800
      }
    ],
    "unit": "元"
  },
  "constraints": [
    {
      "name": "芯片供应限制",
      "terms": [
        {
          "variable": "x_phone",
          "coefficient": 2
        },
        {
          "variable": "x_computer",
          "coefficient": 1
        }
      ],
      "sense": "<=",
      "rhs": 100,
      "unit": "个"
    },
    {
      "name": "屏幕供应限制",
      "terms": [
        {
          "variable": "x_phone",
          "coefficient": 1
        },
        {
          "variable": "x_computer",
          "coefficient": 2
        }
      ],
      "sense": "<=",
      "rhs": 80,
      "unit": "块"
    },
    {
      "name": "组装工时限制",
      "terms": [
        {
          "variable": "x_phone",
          "coefficient": 1
        },
        {
          "variable": "x_computer",
          "coefficient": 3
        }
      ],
      "sense": "<=",
      "rhs": 120,
      "unit": "小时"
    },
    {
      "name": "电脑产量不超过手机产量",
      "terms": [
        {
          "variable": "x_computer",
          "coefficient": 1
        },
        {
          "variable": "x_phone",
          "coefficient": -1
        }
      ],
      "sense": "<=",
      "rhs": 0,
      "unit": "台"
    }
  ]
}
