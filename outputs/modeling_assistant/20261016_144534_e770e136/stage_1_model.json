{
  "name": "电子厂手机与电脑日生产计划",
  "assumptions": [
    "手机和电脑的产量按整件实物计，变量为非负整数。",
    "每天芯片、屏幕和组装工时供应上限分别为100个、80块和120小时。",
    "所有生产数量均不超过对应资源约束决定的可行范围。",
    "市场策略约束为电脑产量不超过手机产量。"
  ],
  "variables": [
    {
      "name": "x_phone",
      "description": "每天生产的手机数量",
      "unit": "部",
      "kind": "integer",
      "lower": 0,
      "upper": null
    },
    {
      "name": "x_computer",
      "description": "每天生产的电脑数量",
      "unit": "台",
      "kind": "integer",
      "lower": 0,
      "upper": null
    }
  ],
  "objective": {
    "sense": "max",
    "terms": [
      {
        "variable": "x_phone",
        "coefficient": 500
      },
      {
        "variable": "x_computer",
        "coefficient": 800
      }
    ],
    "unit": "元"
  },
  "constraints": [
    {
      "name": "chip_supply",
      "terms": [
        {
          "variable": "x_phone",
          "coefficient": 2
        },
        {
          "variable": "x_computer",
          "coefficient": 1
        }
      ],
      "sense": "<=",
      "rhs": 100,
      "unit": "个"
    },
    {
      "name": "screen_supply",
      "terms": [
        {
          "variable": "x_phone",
          "coefficient": 1
        },
        {
          "variable": "x_computer",
          "coefficient": 2
        }
      ],
      "sense": "<=",
      "rhs": 80,
      "unit": "块"
    },
    {
      "name": "assembly_hours",
      "terms": [
        {
          "variable": "x_phone",
          "coefficient": 1
        },
        {
          "variable": "x_computer",
          "coefficient": 3
        }
      ],
      "sense": "<=",
      "rhs": 120,
      "unit": "小时"
    },
    {
      "name": "market_strategy",
      "terms": [
        {
          "variable": "x_computer",
          "coefficient": 1
        },
        {
          "variable": "x_phone",
          "coefficient": -1
        }
      ],
      "sense": "<=",
      "rhs": 0,
      "unit": "台"
    }
  ]
}
