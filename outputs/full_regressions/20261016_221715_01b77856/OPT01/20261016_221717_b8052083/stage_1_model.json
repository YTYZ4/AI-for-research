{
  "name": "产品A和B生产计划优化",
  "assumptions": [
    "A、B的产量按整件实物处理，取非负整数。",
    "工时和原料消耗均为每件产品的固定消耗，且可分割。",
    "本期工时和原料供应上限分别为100小时和80千克。",
    "没有其他约束或资源限制。"
  ],
  "variables": [
    {
      "name": "x_A",
      "description": "产品A的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    },
    {
      "name": "x_B",
      "description": "产品B的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    }
  ],
  "objective": {
    "sense": "max",
    "terms": [
      {
        "variable": "x_A",
        "coefficient": 40
      },
      {
        "variable": "x_B",
        "coefficient": 30
      }
    ],
    "unit": "元"
  },
  "constraints": [
    {
      "name": "工时限制",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 2
        },
        {
          "variable": "x_B",
          "coefficient": 1
        }
      ],
      "sense": "<=",
      "rhs": 100,
      "unit": "小时"
    },
    {
      "name": "原料限制",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 1
        },
        {
          "variable": "x_B",
          "coefficient": 2
        }
      ],
      "sense": "<=",
      "rhs": 80,
      "unit": "千克"
    }
  ]
}
