{
  "name": "工厂A/B产品生产计划",
  "assumptions": [
    "产品A、B的产量均为非负整数件。",
    "工时和原料为可分割资源，单位消耗分别按小时/件和千克/件计。",
    "利润、工时和原料数据均为确定已知常数。",
    "没有其他资源限制、库存限制或市场需求上限。"
  ],
  "variables": [
    {
      "name": "x_A",
      "description": "产品A的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    },
    {
      "name": "x_B",
      "description": "产品B的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    }
  ],
  "objective": {
    "sense": "max",
    "terms": [
      {
        "variable": "x_A",
        "coefficient": 40
      },
      {
        "variable": "x_B",
        "coefficient": 30
      }
    ],
    "unit": "元"
  },
  "constraints": [
    {
      "name": "工时上限",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 2
        },
        {
          "variable": "x_B",
          "coefficient": 1
        }
      ],
      "sense": "<=",
      "rhs": 100,
      "unit": "小时"
    },
    {
      "name": "原料上限",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 1
        },
        {
          "variable": "x_B",
          "coefficient": 2
        }
      ],
      "sense": "<=",
      "rhs": 80,
      "unit": "千克"
    },
    {
      "name": "产品A最低产量",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 1
        }
      ],
      "sense": ">=",
      "rhs": 60,
      "unit": "件"
    }
  ]
}
