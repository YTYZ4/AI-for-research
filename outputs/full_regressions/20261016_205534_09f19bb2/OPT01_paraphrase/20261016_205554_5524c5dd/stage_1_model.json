{
  "name": "产品A与B的生产计划",
  "assumptions": [
    "A、B为整件产品，产量取非负整数。",
    "工时可分割且本期总工时不超过100小时。",
    "原料可分割且本期总原料不超过80千克。",
    "没有其他资源或市场限制。"
  ],
  "variables": [
    {
      "name": "x_A",
      "description": "产品A的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    },
    {
      "name": "x_B",
      "description": "产品B的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    }
  ],
  "objective": {
    "sense": "max",
    "terms": [
      {
        "variable": "x_A",
        "coefficient": 40
      },
      {
        "variable": "x_B",
        "coefficient": 30
      }
    ],
    "unit": "元"
  },
  "constraints": [
    {
      "name": "工时限制",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 2
        },
        {
          "variable": "x_B",
          "coefficient": 1
        }
      ],
      "sense": "<=",
      "rhs": 100,
      "unit": "小时"
    },
    {
      "name": "原料限制",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 1
        },
        {
          "variable": "x_B",
          "coefficient": 2
        }
      ],
      "sense": "<=",
      "rhs": 80,
      "unit": "千克"
    }
  ]
}
