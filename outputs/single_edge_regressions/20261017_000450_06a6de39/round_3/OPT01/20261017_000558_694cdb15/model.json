{
  "name": "production_planning",
  "assumptions": [
    "A、B两种产品的产量均为非负整数件。",
    "工时和原料的消耗系数为固定常参数，不随产量变化。",
    "本期工时上限为100小时，原料上限为80千克。",
    "没有其他资源约束或市场需求约束。"
  ],
  "variables": [
    {
      "name": "x_A",
      "description": "产品A的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    },
    {
      "name": "x_B",
      "description": "产品B的产量",
      "unit": "件",
      "kind": "integer",
      "lower": 0,
      "upper": null
    }
  ],
  "objective": {
    "sense": "max",
    "terms": [
      {
        "variable": "x_A",
        "coefficient": 40
      },
      {
        "variable": "x_B",
        "coefficient": 30
      }
    ],
    "unit": "元"
  },
  "constraints": [
    {
      "name": "labor_hours",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 2
        },
        {
          "variable": "x_B",
          "coefficient": 1
        }
      ],
      "sense": "<=",
      "rhs": 100,
      "unit": "小时"
    },
    {
      "name": "raw_material",
      "terms": [
        {
          "variable": "x_A",
          "coefficient": 1
        },
        {
          "variable": "x_B",
          "coefficient": 2
        }
      ],
      "sense": "<=",
      "rhs": 80,
      "unit": "千克"
    }
  ]
}
